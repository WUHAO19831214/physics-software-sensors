{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WUHAO19831214/physics-software-sensors/contracts/schemas/sensor-manifest.schema.json",
  "title": "Physics Software Sensor Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name_zh", "name_en", "category", "maturity", "implementation_status", "version", "input_kinds", "output_kinds", "capabilities", "source_references", "evidence_level", "license_review", "owners"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
    "name_zh": {"type": "string", "minLength": 1},
    "name_en": {"type": "string", "minLength": 1},
    "category": {"enum": ["source", "processor", "fusion"]},
    "maturity": {"enum": ["planned", "incubating", "candidate", "stable", "deprecated", "retired"]},
    "implementation_status": {"enum": ["contract-only", "adapter-present", "implemented"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "input_kinds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "output_kinds": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "source_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "commit", "paths", "notes"],
        "properties": {
          "repository": {"type": "string", "pattern": "^https://github\\.com/"},
          "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "paths": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "notes": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence_level": {"enum": ["documented-prototype", "source-tested", "replay-benchmarked", "hardware-validated"]},
    "license_review": {"enum": ["pending", "approved", "blocked"]},
    "known_boundaries": {"type": "array", "items": {"type": "string"}},
    "owners": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
  }
}
