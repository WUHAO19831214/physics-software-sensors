{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WUHAO19831214/physics-software-sensors/contracts/schemas/sensor-event.schema.json",
  "title": "Physics Software Sensor Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "run_id", "sensor", "sequence", "time", "status", "quality", "measurements"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "event_id": {"type": "string", "format": "uuid"},
    "run_id": {"type": "string", "minLength": 1},
    "sensor": {"$ref": "#/$defs/sensorIdentity"},
    "sequence": {"type": "integer", "minimum": 0},
    "time": {"$ref": "#/$defs/timeInfo"},
    "status": {"enum": ["ok", "degraded", "lost", "error"]},
    "quality": {"$ref": "#/$defs/quality"},
    "measurements": {"type": "array", "items": {"$ref": "#/$defs/measurement"}},
    "coordinate_frame": {"$ref": "#/$defs/coordinateFrame"},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "parent_event_ids": {"type": "array", "items": {"type": "string", "format": "uuid"}, "uniqueItems": true},
    "payload": {"type": "object"},
    "error": {"$ref": "#/$defs/error"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ok"}}},
      "then": {"properties": {"measurements": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"status": {"const": "error"}}},
      "then": {"required": ["error"]}
    }
  ],
  "$defs": {
    "sensorIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "instance_id", "version", "category"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
        "instance_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
        "category": {"enum": ["source", "processor", "fusion"]}
      }
    },
    "timeInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "emitted_at", "monotonic_ns", "clock"],
      "properties": {
        "observed_at": {"type": "string", "format": "date-time"},
        "emitted_at": {"type": "string", "format": "date-time"},
        "source_timestamp": {"type": ["number", "null"]},
        "monotonic_ns": {"type": "integer", "minimum": 0},
        "clock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain", "sync_status"],
          "properties": {
            "domain": {"type": "string", "minLength": 1},
            "sync_status": {"enum": ["unknown", "single-clock", "estimated", "hardware-synced"]},
            "uncertainty_ms": {"type": ["number", "null"], "minimum": 0}
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flags", "dropped_since_last"],
      "properties": {
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "latency_ms": {"type": ["number", "null"], "minimum": 0},
        "flags": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "uniqueItems": true},
        "dropped_since_last": {"type": "integer", "minimum": 0}
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "value_type", "unit", "role"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "value": {"type": ["number", "integer", "string", "boolean", "null"]},
        "value_type": {"enum": ["number", "integer", "string", "boolean"]},
        "unit": {"type": "string", "minLength": 1},
        "role": {"enum": ["raw", "filtered", "derived", "calibrated"]},
        "uncertainty": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "coordinateFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "space", "origin", "x_direction", "y_direction", "unit"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "space": {"enum": ["image-pixel", "image-normalized", "calibrated-2d", "world-3d"]},
        "origin": {"type": "string", "minLength": 1},
        "x_direction": {"type": "string", "minLength": 1},
        "y_direction": {"type": "string", "minLength": 1},
        "z_direction": {"type": "string"},
        "unit": {"type": "string", "minLength": 1},
        "width": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "height": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "calibration_id": {"type": ["string", "null"]}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "uri", "media_type", "sha256"],
      "properties": {
        "role": {"enum": ["input", "output", "debug", "model", "calibration"]},
        "uri": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "message": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"},
        "cause": {"type": ["string", "null"]}
      }
    }
  }
}
