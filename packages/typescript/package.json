{
  "name": "@physics-software-sensors/core",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "description": "Experimental TypeScript adapters and contracts for physics software sensors",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": ["dist/src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:tesseract": "npm run build && node --test dist/tests/tesseract-integration.test.js"
  },
  "dependencies": {
    "pngjs": "^7.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.9.0"
  }
}
